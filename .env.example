
# Asynchronous SQLAlchemy URL (asyncpg)
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mywellness

# Synchronous SQLAlchemy URL
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/mywellness

# Optional: used by docker-compose service if present
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mywellness

# App secret (change to a secure random string in production)
SECRET_KEY=change_this_to_a_secure_random_string

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
